<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Uma mensagem do dia inspirada pelo inconfundível Ron Swanson."
    />
    <title>Mensagem do Dia | Ron Swanson</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
      <section class="message-card card border-0 shadow-lg text-center">
        <div class="card-body p-4 p-md-5">
          <p class="eyebrow text-uppercase fw-semibold mb-3">Seu momento de sabedoria</p>
          <h1 class="display-5 fw-bold mb-4">Mensagem do Dia</h1>

          <% if (error) { %>
            <div class="alert alert-warning" role="alert"><%= error %></div>
          <% } else { %>
            <blockquote class="quote mb-4">
              <p class="mb-0">“<%= quote %>”</p>
            </blockquote>
            <p class="attribution mb-4">— Ron Swanson</p>
          <% } %>

          <a class="btn btn-primary btn-lg" href="/" role="button">
            Nova mensagem
          </a>
        </div>
      </section>
    </main>
  </body>
</html>
